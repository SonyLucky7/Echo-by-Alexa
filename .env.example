# ─── Database ───
DATABASE_URL="file:./dev.db"
# Production PostgreSQL/Supabase:
# DATABASE_URL="postgresql://user:password@host:5432/echo?schema=public"

# ─── Application ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── AI / LLM Provider (Optional - works with local fallback if empty) ───
# Google Gemini:
GOOGLE_GENERATIVE_AI_API_KEY=""
AI_MODEL="gemini-2.0-flash"
# Or OpenAI:
# OPENAI_API_KEY=""
# AI_MODEL="gpt-4o-mini"

# ─── ElevenLabs Voice (Optional - falls back to Web Speech API if empty) ───
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_VOICE_ID="sXSV9RZ095VZyL64w3ap"

# ─── Stripe Payments (Optional - sandbox simulated checkout active if empty) ───
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Restaurant Configuration ───
RESTAURANT_BASE_CURRENCY="USD"
RESTAURANT_TAX_RATE_BPS="825"

# ─── Staff Portal ───
STAFF_PASSWORD="echo-hearth-pass"
